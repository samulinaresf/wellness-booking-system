#Postgres
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=your_database

#Database
DATABASE_URL=postgresql://your_user:your_password@db:5432/wellness_db
DATABASE_TEST_URL=postgresql://your_user:your_password@localhost:5433/wellness_test_db

#JWT
JWT_SECRET_KEY=your_secret_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

#EMAIL
SMTP_EMAIL=company_email
SMTP_PASSWORD=company_password
